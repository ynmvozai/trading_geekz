# Copia este archivo como .env (nunca subas .env a Git). En Railway van en Variables.
WEBHOOK_CRYPTO=          # #cryptoman (BTC y SOL)
WEBHOOK_ORO=             # #oro-índice (XAU)
WEBHOOK_AGENT=           # #agent-👾🤖 (TITO y comandos)
WEBHOOK_AICRYPTO=        # #ai-crypto (señales Ai Crypto)
WEBHOOK_RESULTADOS=      # #resultados (resumen de los domingos). Opcional: sin él va a #agent
DISCORD_BOT_TOKEN=       # bot con Message Content Intent activado
ANTHROPIC_API_KEY=       # llave de la API de Anthropic (TITO)
TZ=America/Puerto_Rico
# Opcionales
# OWNER_IDS=             # IDs de Discord que pueden usar comandos de control (por defecto: el dueño del servidor)
# DATA_DIR=/data         # carpeta de la base de datos (Railway la pone sola si hay volumen)
# AGENT_CHANNEL_ID=1557585826810962102
